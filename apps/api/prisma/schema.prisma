datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  DIGITIZER
  GUARDIAN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum CatalogKind {
  VACCINATION_SCHEDULE
  HEMOGLOBIN_THRESHOLDS
  APPOINTMENT_INTERVALS
}

enum CatalogStatus {
  DRAFT
  PUBLISHED
}

enum AppointmentType {
  GROWTH_CHECK
  VACCINATION
  HEMOGLOBIN_TEST
}

enum Sex {
  FEMALE
  MALE
}

enum DeliveryType {
  VAGINAL
  CESAREAN
}

enum Relationship {
  MOTHER
  FATHER
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  ATTENDED
  MISSED
  CANCELLED
}

enum AppointmentOrigin {
  DIGITIZER
  SYSTEM
}

enum NotificationKind {
  APPOINTMENT_REMINDER
  DOSE_OVERDUE
  CARNET_UPDATED
}

enum NotificationChannel {
  EMAIL
  PUSH
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

enum LinkStatus {
  PENDING
  ACTIVE
  EXPIRED
  REVOKED
}

enum MeasurementPosition {
  LYING
  STANDING
}

enum AnemiaClass {
  NONE
  MILD
  MODERATE
  SEVERE
  UNCLASSIFIED
}

enum IronProduct {
  DROPS
  SYRUP
  MICRONUTRIENTS
  TABLETS
}

enum IronPurpose {
  PREVENTION
  TREATMENT
}

enum ClinicalRecordType {
  DOSE
  GROWTH_CHECK
  HEMOGLOBIN_TEST
  IRON_SUPPLY
}

enum CorrectionStatus {
  REQUESTED
  APPROVED
  REJECTED
}

model Account {
  id                     String        @id @default(uuid()) @db.Uuid
  email                  String?       @unique @db.VarChar(254)
  dni                    String?       @unique @db.Char(8)
  fullName               String        @map("full_name") @db.VarChar(160)
  role                   Role
  status                 AccountStatus @default(ACTIVE)
  passwordHash           String        @map("password_hash") @db.VarChar(255)
  passwordChangeRequired Boolean       @default(true) @map("password_change_required")
  totpSecretEncrypted    String?       @map("totp_secret_encrypted") @db.VarChar(255)
  totpEnabledAt          DateTime?     @map("totp_enabled_at") @db.Timestamptz(3)
  totpLastTimeStep       Int?          @map("totp_last_time_step")
  failedAttempts         Int           @default(0) @map("failed_attempts")
  lockedUntil            DateTime?     @map("locked_until") @db.Timestamptz(3)
  version                Int           @default(1)
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions            Session[]
  assignments         FacilityAssignment[] @relation("AssignedAccount")
  assignmentsGranted  FacilityAssignment[] @relation("AssignmentGrantedBy")
  assignmentsEnded    FacilityAssignment[] @relation("AssignmentEndedBy")
  catalogVersions     CatalogVersion[]
  auditEvents         AuditEvent[]
  idempotencyKeys     IdempotencyKey[]
  childrenCreated     Child[]
  guardian            Guardian?
  linksCreated        GuardianLink[]       @relation("LinkCreatedBy")
  linksRevoked        GuardianLink[]       @relation("LinkRevokedBy")
  activationCodes     ActivationCode[]
  dosesRecorded       AdministeredDose[]
  growthChecks        GrowthCheck[]
  hemoglobinTests     HemoglobinTest[]
  ironSupplies        IronSupply[]
  correctionsAsked    CorrectionRequest[]  @relation("CorrectionRequestedBy")
  correctionsResolved CorrectionRequest[]  @relation("CorrectionResolvedBy")
  appointmentsCreated Appointment[]        @relation("AppointmentCreatedBy")
  appointmentsClosed  Appointment[]        @relation("AppointmentClosedBy")
  notificationSetting NotificationSetting?
  pushSubscriptions   PushSubscription[]
  notifications       Notification[]
  childPhotos         ChildPhoto[]

  @@map("accounts")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  accountId        String    @map("account_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.Char(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@map("sessions")
}

model Facility {
  id             String   @id @default(uuid()) @db.Uuid
  ipressCode     String   @unique @map("ipress_code") @db.Char(8)
  name           String   @db.VarChar(160)
  healthNetwork  String   @map("health_network") @db.VarChar(120)
  altitudeMeters Int      @map("altitude_meters")
  active         Boolean  @default(true)
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  assignments       FacilityAssignment[]
  childrenCreated   Child[]
  links             GuardianLink[]
  administeredDoses AdministeredDose[]
  growthChecks      GrowthCheck[]
  hemoglobinTests   HemoglobinTest[]
  ironSupplies      IronSupply[]
  appointments      Appointment[]

  @@map("facilities")
}

model FacilityAssignment {
  id          String    @id @default(uuid()) @db.Uuid
  accountId   String    @map("account_id") @db.Uuid
  facilityId  String    @map("facility_id") @db.Uuid
  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt     DateTime? @map("ended_at") @db.Timestamptz(3)
  grantedById String    @map("granted_by_id") @db.Uuid
  endedById   String?   @map("ended_by_id") @db.Uuid

  account   Account  @relation("AssignedAccount", fields: [accountId], references: [id])
  facility  Facility @relation(fields: [facilityId], references: [id])
  grantedBy Account  @relation("AssignmentGrantedBy", fields: [grantedById], references: [id])
  endedBy   Account? @relation("AssignmentEndedBy", fields: [endedById], references: [id])

  @@index([accountId])
  @@index([facilityId])
  @@map("facility_assignments")
}

model Vaccine {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(32)
  name      String   @db.VarChar(120)
  prevents  String   @db.VarChar(240)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  scheduledDoses    ScheduledDose[]
  administeredDoses AdministeredDose[]

  @@map("vaccines")
}

model CatalogVersion {
  id          String        @id @default(uuid()) @db.Uuid
  kind        CatalogKind
  norm        String        @db.VarChar(240)
  status      CatalogStatus @default(DRAFT)
  validFrom   DateTime?     @map("valid_from") @db.Date
  validTo     DateTime?     @map("valid_to") @db.Date
  publishedAt DateTime?     @map("published_at") @db.Timestamptz(3)
  createdById String        @map("created_by_id") @db.Uuid
  version     Int           @default(1)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy            Account                        @relation(fields: [createdById], references: [id])
  scheduledDoses       ScheduledDose[]
  hemoglobinThresholds HemoglobinThreshold[]
  appointmentIntervals AppointmentInterval[]
  altitudeAdjustments  HemoglobinAltitudeAdjustment[]
  hemoglobinTests      HemoglobinTest[]

  @@index([kind, status, validFrom])
  @@map("catalog_versions")
}

model ScheduledDose {
  id                 String @id @default(uuid()) @db.Uuid
  catalogVersionId   String @map("catalog_version_id") @db.Uuid
  vaccineId          String @map("vaccine_id") @db.Uuid
  doseNumber         Int    @map("dose_number")
  recommendedAgeDays Int    @map("recommended_age_days")
  maxAgeDays         Int    @map("max_age_days")

  catalogVersion    CatalogVersion     @relation(fields: [catalogVersionId], references: [id], onDelete: Cascade)
  vaccine           Vaccine            @relation(fields: [vaccineId], references: [id])
  administeredDoses AdministeredDose[]

  @@unique([catalogVersionId, vaccineId, doseNumber])
  @@map("scheduled_doses")
}

model HemoglobinThreshold {
  id               String  @id @default(uuid()) @db.Uuid
  catalogVersionId String  @map("catalog_version_id") @db.Uuid
  minAgeMonths     Int     @map("min_age_months")
  maxAgeMonths     Int     @map("max_age_months")
  normalFrom       Decimal @map("normal_from") @db.Decimal(4, 1)
  mildFrom         Decimal @map("mild_from") @db.Decimal(4, 1)
  moderateFrom     Decimal @map("moderate_from") @db.Decimal(4, 1)

  catalogVersion CatalogVersion @relation(fields: [catalogVersionId], references: [id], onDelete: Cascade)

  @@unique([catalogVersionId, minAgeMonths])
  @@map("hemoglobin_thresholds")
}

model AppointmentInterval {
  id               String          @id @default(uuid()) @db.Uuid
  catalogVersionId String          @map("catalog_version_id") @db.Uuid
  appointmentType  AppointmentType @map("appointment_type")
  minAgeMonths     Int             @map("min_age_months")
  maxAgeMonths     Int             @map("max_age_months")
  intervalDays     Int             @map("interval_days")

  catalogVersion CatalogVersion @relation(fields: [catalogVersionId], references: [id], onDelete: Cascade)

  @@unique([catalogVersionId, appointmentType, minAgeMonths])
  @@map("appointment_intervals")
}

model AuditEvent {
  id         BigInt   @id @default(autoincrement())
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(64)
  entity     String   @db.VarChar(32)
  entityId   String   @map("entity_id") @db.Uuid
  before     Json?
  after      Json?
  ip         String?  @db.VarChar(45)

  actor Account? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entity, entityId, occurredAt])
  @@index([occurredAt])
  @@map("audit_events")
}

model IdempotencyKey {
  accountId      String   @map("account_id") @db.Uuid
  key            String   @db.VarChar(64)
  operation      String   @db.VarChar(64)
  requestHash    String   @map("request_hash") @db.Char(64)
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id])

  @@id([accountId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model Child {
  id                  String   @id @default(uuid()) @db.Uuid
  dni                 String?  @unique @db.Char(8)
  cnv                 String?  @unique @db.VarChar(12)
  givenNames          String   @map("given_names") @db.VarChar(120)
  paternalSurname     String   @map("paternal_surname") @db.VarChar(80)
  maternalSurname     String   @map("maternal_surname") @db.VarChar(80)
  sex                 Sex
  birthDate           DateTime @map("birth_date") @db.Date
  gestationalWeeks    Int?     @map("gestational_weeks")
  bloodType           String?  @map("blood_type") @db.VarChar(3)
  createdById         String   @map("created_by_id") @db.Uuid
  createdAtFacilityId String   @map("created_at_facility_id") @db.Uuid
  version             Int      @default(1)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy         Account             @relation(fields: [createdById], references: [id])
  createdAtFacility Facility            @relation(fields: [createdAtFacilityId], references: [id])
  birthRecord       BirthRecord?
  links             GuardianLink[]
  administeredDoses AdministeredDose[]
  growthChecks      GrowthCheck[]
  hemoglobinTests   HemoglobinTest[]
  ironSupplies      IronSupply[]
  corrections       CorrectionRequest[]
  appointments      Appointment[]
  photos            ChildPhoto[]

  @@map("children")
}

model BirthRecord {
  childId             String        @id @map("child_id") @db.Uuid
  birthPlace          String?       @map("birth_place") @db.VarChar(160)
  deliveryType        DeliveryType? @map("delivery_type")
  weightGrams         Int?          @map("weight_grams")
  lengthCm            Decimal?      @map("length_cm") @db.Decimal(4, 1)
  headCircumferenceCm Decimal?      @map("head_circumference_cm") @db.Decimal(4, 1)
  apgar1              Int?          @map("apgar_1")
  apgar5              Int?          @map("apgar_5")

  child Child @relation(fields: [childId], references: [id])

  @@map("birth_records")
}

model Guardian {
  id              String   @id @default(uuid()) @db.Uuid
  dni             String   @unique @db.Char(8)
  givenNames      String   @map("given_names") @db.VarChar(120)
  paternalSurname String   @map("paternal_surname") @db.VarChar(80)
  maternalSurname String   @map("maternal_surname") @db.VarChar(80)
  phone           String?  @db.VarChar(15)
  email           String?  @db.VarChar(254)
  accountId       String?  @unique @map("account_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  account Account?       @relation(fields: [accountId], references: [id])
  links   GuardianLink[]

  @@map("guardians")
}

model GuardianLink {
  id                 String       @id @default(uuid()) @db.Uuid
  childId            String       @map("child_id") @db.Uuid
  guardianId         String       @map("guardian_id") @db.Uuid
  relationship       Relationship
  status             LinkStatus
  consentVersion     String       @map("consent_version") @db.VarChar(16)
  consentAt          DateTime     @map("consent_at") @db.Timestamptz(3)
  createdById        String       @map("created_by_id") @db.Uuid
  facilityId         String       @map("facility_id") @db.Uuid
  revokedById        String?      @map("revoked_by_id") @db.Uuid
  revokedAt          DateTime?    @map("revoked_at") @db.Timestamptz(3)
  revocationReason   String?      @map("revocation_reason") @db.VarChar(500)
  revocationDocument String?      @map("revocation_document") @db.VarChar(160)
  version            Int          @default(1)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  child           Child            @relation(fields: [childId], references: [id])
  guardian        Guardian         @relation(fields: [guardianId], references: [id])
  createdBy       Account          @relation("LinkCreatedBy", fields: [createdById], references: [id])
  revokedBy       Account?         @relation("LinkRevokedBy", fields: [revokedById], references: [id])
  facility        Facility         @relation(fields: [facilityId], references: [id])
  activationCodes ActivationCode[]

  @@index([childId])
  @@index([guardianId])
  @@map("guardian_links")
}

model ActivationCode {
  id         String    @id @default(uuid()) @db.Uuid
  linkId     String    @map("link_id") @db.Uuid
  codeHash   String    @map("code_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  issuedById String    @map("issued_by_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  link     GuardianLink @relation(fields: [linkId], references: [id])
  issuedBy Account      @relation(fields: [issuedById], references: [id])

  @@index([linkId])
  @@index([codeHash], map: "activation_codes_hash_idx")
  @@map("activation_codes")
}

model HemoglobinAltitudeAdjustment {
  id               String  @id @default(uuid()) @db.Uuid
  catalogVersionId String  @map("catalog_version_id") @db.Uuid
  minAltitude      Int     @map("min_altitude")
  maxAltitude      Int     @map("max_altitude")
  subtract         Decimal @db.Decimal(3, 1)

  catalogVersion CatalogVersion @relation(fields: [catalogVersionId], references: [id], onDelete: Cascade)

  @@unique([catalogVersionId, minAltitude])
  @@map("hemoglobin_altitude_adjustments")
}

model AdministeredDose {
  id               String   @id @default(uuid()) @db.Uuid
  childId          String   @map("child_id") @db.Uuid
  scheduledDoseId  String   @map("scheduled_dose_id") @db.Uuid
  vaccineId        String   @map("vaccine_id") @db.Uuid
  doseNumber       Int      @map("dose_number")
  administeredOn   DateTime @map("administered_on") @db.Date
  lot              String   @db.VarChar(40)
  outOfRangeReason String?  @map("out_of_range_reason") @db.VarChar(300)
  facilityId       String   @map("facility_id") @db.Uuid
  recordedById     String   @map("recorded_by_id") @db.Uuid
  recordedAt       DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)
  version          Int      @default(1)
  isCurrent        Boolean  @default(true) @map("is_current")
  replacesId       String?  @unique @map("replaces_id") @db.Uuid
  correctionReason String?  @map("correction_reason") @db.VarChar(300)

  child         Child             @relation(fields: [childId], references: [id])
  scheduledDose ScheduledDose     @relation(fields: [scheduledDoseId], references: [id])
  vaccine       Vaccine           @relation(fields: [vaccineId], references: [id])
  facility      Facility          @relation(fields: [facilityId], references: [id])
  recordedBy    Account           @relation(fields: [recordedById], references: [id])
  replaces      AdministeredDose? @relation("DoseReplacement", fields: [replacesId], references: [id])
  replacedBy    AdministeredDose? @relation("DoseReplacement")

  @@index([childId])
  @@map("administered_doses")
}

model GrowthCheck {
  id                  String              @id @default(uuid()) @db.Uuid
  childId             String              @map("child_id") @db.Uuid
  measuredOn          DateTime            @map("measured_on") @db.Date
  weightKg            Decimal             @map("weight_kg") @db.Decimal(5, 3)
  lengthCm            Decimal             @map("length_cm") @db.Decimal(4, 1)
  position            MeasurementPosition
  headCircumferenceCm Decimal?            @map("head_circumference_cm") @db.Decimal(4, 1)
  ageDays             Int                 @map("age_days")
  correctedAgeDays    Int                 @map("corrected_age_days")
  zWeightForAge       Decimal?            @map("z_weight_for_age") @db.Decimal(4, 2)
  zLengthForAge       Decimal?            @map("z_length_for_age") @db.Decimal(4, 2)
  zWeightForLength    Decimal?            @map("z_weight_for_length") @db.Decimal(4, 2)
  zHeadForAge         Decimal?            @map("z_head_for_age") @db.Decimal(4, 2)
  weightForAge        String?             @map("weight_for_age") @db.VarChar(24)
  lengthForAge        String?             @map("length_for_age") @db.VarChar(24)
  weightForLength     String?             @map("weight_for_length") @db.VarChar(24)
  headForAge          String?             @map("head_for_age") @db.VarChar(24)
  referenceVersion    String              @map("reference_version") @db.VarChar(16)
  facilityId          String              @map("facility_id") @db.Uuid
  recordedById        String              @map("recorded_by_id") @db.Uuid
  recordedAt          DateTime            @default(now()) @map("recorded_at") @db.Timestamptz(3)
  version             Int                 @default(1)
  isCurrent           Boolean             @default(true) @map("is_current")
  replacesId          String?             @unique @map("replaces_id") @db.Uuid
  correctionReason    String?             @map("correction_reason") @db.VarChar(300)

  child      Child        @relation(fields: [childId], references: [id])
  facility   Facility     @relation(fields: [facilityId], references: [id])
  recordedBy Account      @relation(fields: [recordedById], references: [id])
  replaces   GrowthCheck? @relation("GrowthReplacement", fields: [replacesId], references: [id])
  replacedBy GrowthCheck? @relation("GrowthReplacement")

  @@index([childId, measuredOn])
  @@map("growth_checks")
}

model HemoglobinTest {
  id                 String      @id @default(uuid()) @db.Uuid
  childId            String      @map("child_id") @db.Uuid
  testedOn           DateTime    @map("tested_on") @db.Date
  observed           Decimal     @db.Decimal(4, 1)
  altitudeMeters     Int         @map("altitude_meters")
  adjustment         Decimal     @db.Decimal(3, 1)
  adjusted           Decimal     @db.Decimal(4, 1)
  ageMonths          Int         @map("age_months")
  classification     AnemiaClass
  thresholdVersionId String      @map("threshold_version_id") @db.Uuid
  facilityId         String      @map("facility_id") @db.Uuid
  recordedById       String      @map("recorded_by_id") @db.Uuid
  recordedAt         DateTime    @default(now()) @map("recorded_at") @db.Timestamptz(3)
  version            Int         @default(1)
  isCurrent          Boolean     @default(true) @map("is_current")
  replacesId         String?     @unique @map("replaces_id") @db.Uuid
  correctionReason   String?     @map("correction_reason") @db.VarChar(300)

  child            Child           @relation(fields: [childId], references: [id])
  thresholdVersion CatalogVersion  @relation(fields: [thresholdVersionId], references: [id])
  facility         Facility        @relation(fields: [facilityId], references: [id])
  recordedBy       Account         @relation(fields: [recordedById], references: [id])
  replaces         HemoglobinTest? @relation("HemoglobinReplacement", fields: [replacesId], references: [id])
  replacedBy       HemoglobinTest? @relation("HemoglobinReplacement")

  @@index([childId, testedOn])
  @@map("hemoglobin_tests")
}

model IronSupply {
  id               String      @id @default(uuid()) @db.Uuid
  childId          String      @map("child_id") @db.Uuid
  suppliedOn       DateTime    @map("supplied_on") @db.Date
  product          IronProduct
  doseInstructions String      @map("dose_instructions") @db.VarChar(200)
  quantity         Int
  purpose          IronPurpose
  facilityId       String      @map("facility_id") @db.Uuid
  recordedById     String      @map("recorded_by_id") @db.Uuid
  recordedAt       DateTime    @default(now()) @map("recorded_at") @db.Timestamptz(3)
  version          Int         @default(1)
  isCurrent        Boolean     @default(true) @map("is_current")
  replacesId       String?     @unique @map("replaces_id") @db.Uuid
  correctionReason String?     @map("correction_reason") @db.VarChar(300)

  child      Child       @relation(fields: [childId], references: [id])
  facility   Facility    @relation(fields: [facilityId], references: [id])
  recordedBy Account     @relation(fields: [recordedById], references: [id])
  replaces   IronSupply? @relation("IronReplacement", fields: [replacesId], references: [id])
  replacedBy IronSupply? @relation("IronReplacement")

  @@index([childId, suppliedOn])
  @@map("iron_supplies")
}

model CorrectionRequest {
  id              String             @id @default(uuid()) @db.Uuid
  recordType      ClinicalRecordType @map("record_type")
  recordId        String             @map("record_id") @db.Uuid
  childId         String             @map("child_id") @db.Uuid
  proposed        Json
  reason          String             @db.VarChar(300)
  status          CorrectionStatus   @default(REQUESTED)
  requestedById   String             @map("requested_by_id") @db.Uuid
  requestedAt     DateTime           @default(now()) @map("requested_at") @db.Timestamptz(3)
  resolvedById    String?            @map("resolved_by_id") @db.Uuid
  resolvedAt      DateTime?          @map("resolved_at") @db.Timestamptz(3)
  rejectionReason String?            @map("rejection_reason") @db.VarChar(300)

  child       Child    @relation(fields: [childId], references: [id])
  requestedBy Account  @relation("CorrectionRequestedBy", fields: [requestedById], references: [id])
  resolvedBy  Account? @relation("CorrectionResolvedBy", fields: [resolvedById], references: [id])

  @@index([status, requestedAt])
  @@index([childId, status])
  @@map("correction_requests")
}

model Appointment {
  id                    String            @id @default(uuid()) @db.Uuid
  childId               String            @map("child_id") @db.Uuid
  facilityId            String            @map("facility_id") @db.Uuid
  type                  AppointmentType
  scheduledOn           DateTime          @map("scheduled_on") @db.Date
  status                AppointmentStatus @default(SCHEDULED)
  origin                AppointmentOrigin
  note                  String?           @db.VarChar(200)
  createdById           String            @map("created_by_id") @db.Uuid
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  closedById            String?           @map("closed_by_id") @db.Uuid
  closedAt              DateTime?         @map("closed_at") @db.Timestamptz(3)
  cancelReason          String?           @map("cancel_reason") @db.VarChar(200)
  reminderSentAt        DateTime?         @map("reminder_sent_at") @db.Timestamptz(3)
  sameDayReminderSentAt DateTime?         @map("same_day_reminder_sent_at") @db.Timestamptz(3)
  version               Int               @default(1)

  child     Child    @relation(fields: [childId], references: [id])
  facility  Facility @relation(fields: [facilityId], references: [id])
  createdBy Account  @relation("AppointmentCreatedBy", fields: [createdById], references: [id])
  closedBy  Account? @relation("AppointmentClosedBy", fields: [closedById], references: [id])

  @@index([facilityId, scheduledOn])
  @@index([childId, status])
  @@map("appointments")
}

model NotificationSetting {
  accountId    String   @id @map("account_id") @db.Uuid
  emailEnabled Boolean  @default(true) @map("email_enabled")
  pushEnabled  Boolean  @default(true) @map("push_enabled")
  email        String?  @db.VarChar(254)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id])

  @@map("notification_settings")
}

model PushSubscription {
  id            String    @id @default(uuid()) @db.Uuid
  accountId     String    @map("account_id") @db.Uuid
  endpoint      String    @unique @db.VarChar(1000)
  p256dh        String    @db.VarChar(200)
  auth          String    @db.VarChar(100)
  userAgent     String?   @map("user_agent") @db.VarChar(300)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@map("push_subscriptions")
}

model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  accountId String              @map("account_id") @db.Uuid
  childId   String?             @map("child_id") @db.Uuid
  kind      NotificationKind
  channel   NotificationChannel
  status    NotificationStatus  @default(QUEUED)
  dedupeKey String              @unique @map("dedupe_key") @db.VarChar(200)
  title     String              @db.VarChar(120)
  body      String              @db.VarChar(400)
  url       String              @db.VarChar(300)
  attempts  Int                 @default(0)
  lastError String?             @map("last_error") @db.VarChar(300)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt    DateTime?           @map("sent_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id])

  @@index([status, createdAt])
  @@index([accountId, createdAt])
  @@map("notifications")
}

model ChildPhoto {
  accountId   String   @map("account_id") @db.Uuid
  childId     String   @map("child_id") @db.Uuid
  contentType String   @map("content_type") @db.VarChar(20)
  data        Bytes
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id])
  child   Child   @relation(fields: [childId], references: [id])

  @@id([accountId, childId])
  @@map("child_photos")
}
